<VirtualHost *:443>
    ServerName sites.example.com
    DocumentRoot /var/www/sites

    <Directory /var/www/sites>
        Options -Indexes -ExecCGI
        AllowOverride None
        Require all granted
    </Directory>

    # ThreadSite appends ?v=<content-hash> to every local asset reference on
    # publish — HTML src/href attributes and ES module import specifiers inside
    # the published JS — so URLs carrying ?v= are content-addressed and safe to
    # cache immutably. Assets requested WITHOUT a version (dynamically built
    # URLs, worker constructions, references the rewriter cannot see) must
    # revalidate instead, so a republished site is picked up immediately via a
    # cheap ETag 304 rather than after the browser cache expires.
    <FilesMatch "\.(?:css|js|mjs)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /^v=[0-9a-f]{10}$/"
        Header set Cache-Control "no-cache" "expr=%{QUERY_STRING} !~ /^v=/"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # If a CDN such as Cloudflare fronts this host, set its "Browser Cache
    # TTL" to "Respect Existing Headers". Otherwise the CDN's default (four
    # hours) overrides the policy above for cacheable extensions and visitors
    # keep stale assets for hours after a republish.

    # Add your normal TLS directives here.
</VirtualHost>
