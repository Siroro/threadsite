# Discord application
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: register commands instantly in one guild while developing.
DISCORD_GUILD_ID=
# Optional comma-separated user IDs that are treated as admins in addition to Manage Server.
DISCORD_ADMIN_USER_IDS=
# Optional private error-report recipients. Blank = use DISCORD_ADMIN_USER_IDS.
DISCORD_ERROR_REPORT_USER_IDS=
ERROR_DM_ENABLED=true
# Minimum interval between public progress-message edits.
PROGRESS_UPDATE_MS=1800

# OpenCode service (internal Docker URL by default)
OPENCODE_URL=http://opencode:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-this-internal-password
# Leave blank to use OpenCode's configured/default model. Format when set: provider/model-id
OPENCODE_DEFAULT_MODEL=opencode/hy3-free
# Enable OpenCode websearch (Exa) even when using a non-OpenCode provider such as Surplus.
OPENCODE_ENABLE_EXA=1
# INFO is usually enough; set DEBUG temporarily when diagnosing provider/tool failures.
OPENCODE_LOG_LEVEL=INFO
# V2.1 transport read-repair: if bot->OpenCode streaming drops while the agent keeps
# running, poll persisted session messages instead of declaring a provider failure.
OPENCODE_RECONCILE_TIMEOUT_MS=1800000
OPENCODE_RECONCILE_POLL_MS=1500
# Session context lifecycle. A thread idle longer than SESSION_IDLE_RESET_MS gets a
# fresh agent session on its next message (the provider prompt cache is cold by then;
# workspace/git/PROJECT_NOTES.md keep the durable state). A turn that ends with the
# context window more than SESSION_CONTEXT_COMPACT_THRESHOLD full compacts the session
# before the next turn starts. Defaults: 2 hours and 0.5; set either to 0 to disable.
SESSION_IDLE_RESET_MS=7200000
SESSION_CONTEXT_COMPACT_THRESHOLD=0.5

# Provider credentials. You can set these here OR later with /site-admin token.
# Optional OpenCode Zen / Go API key. Leave blank for anonymous/free models when supported.
OPENCODE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Surplus Intelligence (OpenAI-compatible custom provider).
# Leave the key blank unless you want to use Surplus. Once set, models are
# refreshed from /v1/models whenever the OpenCode container starts.
SURPLUS_API_KEY=
SURPLUS_BASE_URL=https://api.surplusintelligence.ai/v1
# Optional comma-separated model IDs. These are merged with live discovery.
# Useful if a just-added model is not returned by discovery or if no key is set yet.
SURPLUS_MODELS=claude-opus-4.8,claude-sonnet-4.6,gpt-5.5,glm-4.7,deepseek-v4-pro,gemini-3.1-pro
# Artificial context ceiling (tokens) OpenCode advertises for Surplus models.
# Auto-compaction triggers relative to this ceiling, so long threads compact early
# instead of growing into huge provider windows. Default 100000; 0 disables the cap.
SURPLUS_CONTEXT_CAP=100000
# Port for the loopback effort-translation proxy inside the OpenCode container.
# It rewrites OpenCode's variant `options.reasoningEffort` wrapper into the
# `reasoning_effort` field Surplus honors, making the bot's /effort command
# effective on models whose catalog advertises the parameter. Default 18098; 0 disables.
SURPLUS_PROXY_PORT=18098

# Forgejo
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:15-rootless
# For your Virtualmin deployment, e.g. https://git.example.com
FORGEJO_PUBLIC_URL=http://localhost:3000
# Bare hostname only, no scheme/path. Set this to git.example.com in production.
FORGEJO_DOMAIN=localhost
FORGEJO_INTERNAL_URL=http://forgejo:3000
# Bound to 127.0.0.1 only; Apache/Virtualmin should reverse-proxy to it.
FORGEJO_PORT=3000
FORGEJO_OWNER=sitebot
FORGEJO_OWNER_TYPE=user
FORGEJO_BOT_EMAIL=sitebot@localhost
# Human administrator for the bundled Forgejo. Leave password blank and bootstrap generates one into secrets/forgejo-admin-password.
FORGEJO_ADMIN_USER=forgeadmin
FORGEJO_ADMIN_EMAIL=forgeadmin@localhost
FORGEJO_ADMIN_PASSWORD=
# Preferred: keep blank and use ./scripts/bootstrap-forgejo.sh, which writes secrets/forgejo-token.
FORGEJO_TOKEN=
FORGEJO_TOKEN_FILE=/run/secrets/forgejo-token
# Admin token for /site pushkey account creation; bootstrap writes secrets/forgejo-admin-token.
FORGEJO_ADMIN_TOKEN_FILE=/run/secrets/forgejo-admin-token
# How often (ms) to poll each repo's main branch for pushes made with a repo push key. 0 disables.
EXTERNAL_PUSH_POLL_MS=60000

# Static publishing
# Point this at a directory your host Apache already serves, e.g. /var/www/sites.
# For the bundled Apache profile, leave this as ./data/sites.
SITES_HOST_PATH=./data/sites
# The public URL corresponding exactly to SITES_HOST_PATH.
PUBLIC_SITES_BASE_URL=http://localhost:8080
PUBLIC_INDEX_ENABLED=true
STATIC_PORT=8080

# Multiplayer relay (one shared multi-tenant container for every game)
# Games connect as tenants by game id + room code; no per-game instance exists.
# Set false to stop provisioning multiplayer files/rules into new game projects.
MULTIPLAYER_ENABLED=true
# URL published games use to reach the relay. ws://localhost:8090/ws works with
# the bundled static profile. For host Apache, proxy wss://games.example.com/ws
# per apache/gameserver-vhost.conf.example and set that URL here.
GAMESERVER_PUBLIC_URL=ws://localhost:8090/ws
# Internal Docker URL the bot uses for /site-admin status health checks.
GAMESERVER_INTERNAL_URL=http://gameserver:8090
# Host port for the relay (loopback-bound; browsers reach it via the proxy above).
GAMESERVER_PORT=8090
# Relay capacity/abuse limits.
GAMESERVER_MAX_PEERS_PER_ROOM=16
GAMESERVER_MAX_ROOMS_PER_GAME=256
GAMESERVER_MAX_MESSAGE_BYTES=65536
# Disconnect slow consumers before relay memory can grow without bound.
GAMESERVER_MAX_BUFFERED_BYTES=524288
GAMESERVER_RATE_PER_SECOND=60
GAMESERVER_RATE_BURST=120
# Empty rooms are garbage-collected after this long (ms).
GAMESERVER_ROOM_TTL_MS=600000
# Optional comma-separated browser origins allowed to open the WebSocket
# (e.g. https://sites.example.com). Empty = allow all origins.
GAMESERVER_ALLOWED_ORIGINS=
# Where the relay persists ARENA (single-mode) worlds so they survive empty
# rooms and relay restarts. One small JSON file per game; private roomed
# sessions are never persisted. The compose file binds ./data/gameserver here.
GAMESERVER_STATE_DIR=/data/threadsite-relay
# How often (ms) dirty arena worlds are flushed to disk (atomic write+rename).
GAMESERVER_PERSIST_INTERVAL_MS=1000

# Agent asset downloads (safe custom tool; HTTPS and public networks only by default)
ASSET_MAX_BYTES=8388608
ASSET_DOWNLOAD_TIMEOUT_MS=30000
ASSET_ALLOW_HTTP=false

# Git identity for auto-commits: the Discord user who sent the request becomes
# the commit author, and the bot is the committer plus a Co-authored-by trailer.
# Point COMMIT_BOT_EMAIL at the Forgejo service account's email
# (FORGEJO_BOT_EMAIL) so Forgejo links the co-author avatar to that account.
COMMIT_BOT_NAME=ThreadBot
# Leave blank to fall back to FORGEJO_BOT_EMAIL, then threadbot@localhost.
COMMIT_BOT_EMAIL=

# Bot diagnostics. JSONL is persisted in data/bot through /data.
LOG_LEVEL=info
LOG_FILE=/data/threadsite.log
# Append-only JSONL token/cost ledger behind /site-admin usage (one line per
# completed agent turn and per AI thread-title prompt).
USAGE_LOG_FILE=/data/usage-log.jsonl

# Safety/resource limits for generated static sites
# 32MB: 3D games bundle Rapier (~2.5MB with inlined WASM) plus GLB/texture/audio assets
MAX_SITE_BYTES=33554432
MAX_SITE_FILES=500
MAX_PROMPT_CHARS=12000
